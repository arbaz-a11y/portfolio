---
import { about } from '../config';
import PortraitCard from './PortraitCard.astro';
---

<section class="section container reveal" id="about">
  <p class="eyebrow">cat about.txt</p>
  <div class="section-head">
    <h2>About Me</h2>
  </div>

  <div class="about-grid">
    <div class="about-visual"><PortraitCard /></div>
    <div class="prose">
      {about.map((p) => <p>{p}</p>)}
    </div>
  </div>
</section>
