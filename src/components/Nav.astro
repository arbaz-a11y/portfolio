---
import { site, nav } from '../config';

// Home page is a one-page scroll; the nav targets sections there. Prefix each
// href with the base path so the same link works from subpages too —
// e.g. "/portfolio/#projects" goes home AND scrolls to the section.
const base = import.meta.env.BASE_URL;
---

<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href={`${base}#top`} aria-label="Home">
      <span>~/</span>cloud-dev
    </a>

    <nav aria-label="Primary">
      <ul class="nav-links" data-nav-links>
        {
          nav.map((item) => (
            <li>
              <a href={`${base}${item.href}`}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav-cta">
      <a class="btn" href={site.resume} download>Resume</a>
      <button class="nav-toggle" data-nav-toggle aria-label="Toggle menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>
