---
import { site } from '../config';
import TerminalWindow from './TerminalWindow.astro';
import PortraitCard from './PortraitCard.astro';
---

<section class="hero" id="top">
  <div class="container hero-grid">
    <div class="hero-copy">
      <div class="hero-badge rise rise-1">
        <span class="chip"><span class="dot dot-green"></span>{site.availability}</span>
      </div>

      <h1 class="rise rise-2"><span class="gradient-text">{site.name}</span></h1>
      <p class="tagline rise rise-3">{site.tagline}</p>

      <div class="hero-ctas rise rise-4">
        <a class="btn btn-primary" href="#projects">See my work</a>
        <a class="btn" href="#contact">Contact</a>
      </div>
    </div>

    <div class="hero-visual">
      <div class="rise rise-2"><PortraitCard /></div>
      <div class="rise rise-4"><TerminalWindow /></div>
    </div>
  </div>
</section>
